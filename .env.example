# Copy to .env (gitignored). Model IDs come from the owner; never hard-code them.
DATABASE_URL="file:./dev.db"
OPENROUTER_API_KEY=                # every cloud model: decisions, text, embeddings, rerank (one key, one spending limit)
OPENROUTER_DEC_MODEL_1=            # decision-model fallback chain, tried in order (add _2, _3, ...)
OPENROUTER_REVIEWER_MODEL=         # central model: all text tiers (proof of concept) + live eval grader
OPENROUTER_EMB_MODEL_1=            # embedding chain through OpenRouter (add _2, _3, ...); corpus, retrieval, coherence
OPENROUTER_RETRIEVAL_MODEL_1=      # rerank chain through OpenRouter (add _2, ...); retrieval reranking
PROVIDER_MODE=cloud                # cloud | local
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=
LOCAL_EMBED_MODEL=nomic-embed-text
TIER_FAST_MODEL=                   # empty -> OPENROUTER_REVIEWER_MODEL
TIER_STANDARD_MODEL=
TIER_PREMIUM_MODEL=
# If a TIER_* is empty and OPENROUTER_REVIEWER_MODEL is empty too, live mode refuses to start.
USE_MOCK_PROVIDERS=false           # true forces all mocks (tests and eval set this)
