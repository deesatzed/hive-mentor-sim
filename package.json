{
  "name": "hive-mentor-sim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:repl": "tsx --conditions=react-server scripts/repl.ts",
    "corpus": "tsx --conditions=react-server scripts/corpus/cli.ts",
    "eval": "tsx --conditions=react-server scripts/eval/cli.ts",
    "eval:live": "tsx --conditions=react-server scripts/eval/cli.ts --live",
    "eval:calibration": "tsx --conditions=react-server scripts/eval/calibration.ts",
    "smoke:live": "tsx --conditions=react-server scripts/smoke/liveCycle.ts",
    "check:prompts": "tsx --conditions=react-server scripts/check-prompts.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:generate": "prisma generate",
    "verify:live": "tsx --conditions=react-server scripts/verify-live.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "gray-matter": "^4.0.3",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
